# Upload this file's adjusted content as the DEV_ENV_FILE GitLab File variable.
APP_NAME="Knowledge Hub"
ENVIRONMENT="development"
FRONTEND_ORIGIN="http://192.168.15.123:8080"

# Keep this value equal to the password in POSTGRES_DSN.
POSTGRES_PASSWORD="postgres"
POSTGRES_DSN="postgresql+asyncpg://postgres:postgres@192.168.15.123:5432/knowledge_hub"

LLM_PROVIDER="local"
LOCAL_LLM_BASE_URL="http://127.0.0.1:1234"
DOCKER_LOCAL_LLM_BASE_URL="http://192.168.15.114:1234"
LOCAL_LLM_MODEL="gpt-oss-20b"

API_LLM_BASE_URL="https://api.openai.com/v1"
API_LLM_MODEL="gpt-4.1-mini"
API_KEY=""
# Required only to save an API key through the authenticated AI settings portal.
# Generate once with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable: changing it makes previously saved API keys unreadable.
CONFIG_ENCRYPTION_KEY=""

EMBEDDING_MODEL="text-embedding-nomic-embed-text-v1.5"
EMBEDDING_VERSION="default"
VECTOR_DIM="768"

MCP_HOST="0.0.0.0"
MCP_PORT="8001"
MCP_PUBLIC_URL="http://192.168.15.123:8001"
MCP_PATH="/mcp"
MCP_WRITE_ENABLED="false"
